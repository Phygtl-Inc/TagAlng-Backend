# Copy this file to .env.local and fill in real values. Ask Tommaso for keys.

# ─── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY  # server-only · never bundled into the app

# ─── Twilio (SMS) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN
TWILIO_FROM_NUMBER=+1XXXXXXXXXX                 # E.164 · verified sender

# ─── Sanity ───────────────────────────────────────────────────
SANITY_PROJECT_ID=YOUR_PROJECT_ID
SANITY_DATASET=production
SANITY_API_TOKEN=                                # only needed for server-side mutations

# ─── Sentry ───────────────────────────────────────────────────
SENTRY_DSN=https://YOUR_DSN@sentry.io/PROJECT_ID

# ─── Environment ──────────────────────────────────────────────
NODE_ENV=development                             # development | staging | production
LOG_LEVEL=info                                   # debug | info | warn | error

# ─── Dev phone auth (Supabase Dashboard → Auth → Phone) ───────
# TEST_PHONE=+15550000000
# TEST_OTP=000000

# ─── Identity worker (Cloud Run / local :8080) · Vertex AI ───
# IDENTITY_WORKER_URL=http://localhost:8080
# GCP_VERTEX_PROJECT=silver-bridge-381702
# GCP_VERTEX_LOCATION=us-central1

# ─── Lana worker orchestrator · OpenAI (ATPR) or Vertex ───
# LANA_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_ROUTER_MODEL=gpt-4o-mini
# OPENAI_SYNTH_MODEL=gpt-4o

# ─── LLM failover (PR9) ───────────────────────────────────────
# 1 = a retryable OpenAI failure (timeout / 429 / 5xx / connection) retries once
# on Vertex Gemini with the SAME token + timeout budget. Auth errors, bad
# requests and model_not_found never fail over — those are our bugs.
# 0 = no failover (pre-PR9 behaviour) — the rollback switch.
LANA_LLM_FALLBACK=1

# Vertex timeout DEFAULTS to OPENAI_TIMEOUT_SEC. Set only to diverge them.
# VERTEX_TIMEOUT_SEC=15

# Ceiling for any Gemini call. A caller's max_tokens is doubled (Gemini 2.5
# spends thinking tokens against the budget) and then clamped to this. Keep it
# above 2x the largest caller budget (4096 extracts) or the headroom is a no-op.
VERTEX_MAX_OUTPUT_TOKENS=8192

# Explicit so OPENAI_TIMEOUT_SEC's real worst case is (retries+1) x timeout.
OPENAI_MAX_RETRIES=2

# Provider-correct /complete extract. MUST match LANA_LLM_PROVIDER. Leave unset.
# LANA_EXTRACT_MODEL=
