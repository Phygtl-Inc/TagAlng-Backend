# Copy to deploy/lana-worker.env (gitignored). Used by scripts/deploy-lana-worker.sh
# and scripts/run-lana-worker-local.sh

SUPABASE_URL=https://rjlcyvwogmfmngemhbmn.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Orchestrator LLM — OpenAI (ATPR default) or Vertex Gemini/Claude
LANA_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_ROUTER_MODEL=gpt-4o-mini
OPENAI_SYNTH_MODEL=gpt-4o
# Extraction (identity claims + circles, and the /complete profile extract) runs on
# the SYNTH tier by default — it must hold the whole schema at once, and a mini tier
# drops the trailing fields. Uncomment only to pin a different one; it MUST match
# the active provider.
# LANA_EXTRACT_MODEL=gpt-4.1

# Vertex — still needed for profile/event fast-path extract unless you migrate those too
GCP_VERTEX_PROJECT=silver-bridge-381702
GCP_VERTEX_LOCATION=us-central1
VERTEX_EXTRACT_MODEL=gemini-2.5-flash
VERTEX_EMBED_MODEL=text-embedding-005
VERTEX_LANA_MODEL=gemini-2.5-flash

# Amplitude (analytics) — PROD ONLY. Set in deploy/lana-worker-prod.env; leave unset
# in dev so dev traffic never lands in product analytics (analytics.py no-ops without it).
# AMPLITUDE_API_KEY=

# Legacy Vertex-only orchestrator (when LANA_LLM_PROVIDER=gemini):
# LANA_LLM_PROVIDER=gemini
# VERTEX_LANA_ROUTER_MODEL=gemini-2.5-flash
# VERTEX_LANA_SYNTH_MODEL=gemini-2.5-pro
# Claude on Vertex (when quota available): LANA_LLM_PROVIDER=claude
# VERTEX_CLAUDE_ROUTER_MODEL=claude-haiku-4-5@20251001
# VERTEX_CLAUDE_SYNTH_MODEL=claude-sonnet-4-6
# VERTEX_CLAUDE_REGION=us-east1

# Lana feature flags (opt-in; require OPENAI/LLM ready)
# LANA_LATENT_EXTRACT=1     # Layer 3 latent-intent collection (entity extractor)
# LANA_REC_PERSONALIZE=1    # Personalize tip_seek Google fallback by the user's own claims
# LANA_DECIDE_TURN=shadow   # Unified policy: off (default) | shadow (log-only diff) | on
# GOOGLE_MAPS_API_KEY=      # required for the tip_seek Places fallback + venue cards

# Shared identity concepts (additive layer over user_identity_claims). Gates ONLY the
# resolve-to-identity_concepts + write-claim_concept_links step; legacy claim writes are
# unconditional and never gated. Feeds score_onion_candidates_for_user's concept half and
# count_shared_concepts_for_user — both read 0 while this is off.
#
# ⚠️  ORDER MATTERS. Push migrations (through 20260918120000_identity_concepts_embedding_repair)
#     BEFORE turning this on. With an un-embedded identity_concepts catalog,
#     match_concepts_by_embedding returns empty and every new claim mints a duplicate
#     concept instead of reusing one — fragmenting the catalog.
# IDENTITY_CONCEPT_LINK_ENABLED=1
# LANA_CONCEPT_TOP_K=5      # nearest-neighbour candidates handed to the LLM verifier
# LANA_CONCEPT_MIN_SIM=0.75 # cosine floor for concept reuse. NOT yet validated in prod:
#                           # latent_extract.py measured this same embedding model topping
#                           # out ~0.55-0.60 for true matches on entity-vs-description,
#                           # which is why _MIN_MATCH_SCORE there is 0.45. Concept-to-concept
#                           # is short-vs-short text so 0.75 may hold — but watch the dedup
#                           # rate for the first week and lower it if identity_concepts grows
#                           # faster than ~1 new concept per 2 new claims.

# Rapport "By the way…" tile cadence. Doc default is MIN_HOURS=6, MAX_PER_7D=3.
# Both 0 = always surface a question whenever a gap is open. Deploy defaults these to 0.
LANA_RAPPORT_MIN_HOURS=0
LANA_RAPPORT_MAX_PER_7D=0

# Rapport tile rotation. refresh = a new question (round-robin by priority, no skip
# penalty) on every reload, debounced by ROTATE_GUARD_S; daily = same question re-shown
# until answered, rotating (as a soft skip) after ROTATE_HOURS unanswered.
LANA_RAPPORT_ROTATE_MODE=refresh
# LANA_RAPPORT_ROTATE_GUARD_S=30
# LANA_RAPPORT_ROTATE_HOURS=24

# Peer matching by radius instead of home-block equality (migration
# 20260921120000). OFF until deliberately flipped: with it off, peers are still
# chosen by `home_block_id = <your block>`, so a neighbour on the adjacent block
# — 0.70 km away in Lake Nona — can never be shown to you. Turning it on swaps
# that for a distance search around your block's centre point.
# LANA_PEER_RADIUS_MATCH=on
# LANA_PEER_RADIUS_METERS=8000

# Max unanswered "which spot is it?" grounding questions open at once (default
# 2). Circles captured past the cap are parked with no question until a slot
# frees, so raise it when testing several activities in one sitting.
# LANA_CIRCLE_GAP_MAX_OPEN=2

# CORS_ALLOW_ORIGINS=http://localhost:3000,https://app.tagalng.com
