# Copy to deploy/lana-worker.env OR reuse deploy/identity-worker.env (same keys).
# Used by scripts/deploy-lana-worker.sh

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GCP_VERTEX_PROJECT=silver-bridge-381702
GCP_VERTEX_LOCATION=us-central1

VERTEX_EXTRACT_MODEL=gemini-2.5-flash
VERTEX_EMBED_MODEL=text-embedding-005
VERTEX_LANA_MODEL=gemini-2.5-flash

# Orchestrator LLM (default: Vertex Gemini). Swap models or provider without code changes.
LANA_LLM_PROVIDER=gemini
VERTEX_LANA_ROUTER_MODEL=gemini-2.5-flash
VERTEX_LANA_SYNTH_MODEL=gemini-2.5-pro
# Claude on Vertex (when quota available): LANA_LLM_PROVIDER=claude
# VERTEX_CLAUDE_ROUTER_MODEL=claude-haiku-4-5@20251001
# VERTEX_CLAUDE_SYNTH_MODEL=claude-sonnet-4-6
# VERTEX_CLAUDE_REGION=us-east1

# CORS_ALLOW_ORIGINS=http://localhost:3000,https://app.tagalng.com
