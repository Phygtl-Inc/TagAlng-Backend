# Copy to deploy/lana-worker.env (gitignored). Used by scripts/deploy-lana-worker.sh
# and scripts/run-lana-worker-local.sh

SUPABASE_URL=https://rjlcyvwogmfmngemhbmn.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Orchestrator LLM — OpenAI (ATPR default) or Vertex Gemini/Claude
LANA_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_ROUTER_MODEL=gpt-4o-mini
OPENAI_SYNTH_MODEL=gpt-4o

# Vertex — still needed for profile/event fast-path extract unless you migrate those too
GCP_VERTEX_PROJECT=silver-bridge-381702
GCP_VERTEX_LOCATION=us-central1
VERTEX_EXTRACT_MODEL=gemini-2.5-flash
VERTEX_EMBED_MODEL=text-embedding-005
VERTEX_LANA_MODEL=gemini-2.5-flash

# Legacy Vertex-only orchestrator (when LANA_LLM_PROVIDER=gemini):
# LANA_LLM_PROVIDER=gemini
# VERTEX_LANA_ROUTER_MODEL=gemini-2.5-flash
# VERTEX_LANA_SYNTH_MODEL=gemini-2.5-pro
# Claude on Vertex (when quota available): LANA_LLM_PROVIDER=claude
# VERTEX_CLAUDE_ROUTER_MODEL=claude-haiku-4-5@20251001
# VERTEX_CLAUDE_SYNTH_MODEL=claude-sonnet-4-6
# VERTEX_CLAUDE_REGION=us-east1

# Lana feature flags (opt-in; require OPENAI/LLM ready)
# LANA_LATENT_EXTRACT=1     # Layer 3 latent-intent collection (entity extractor)
# LANA_REC_PERSONALIZE=1    # Personalize tip_seek Google fallback by the user's own claims
# GOOGLE_MAPS_API_KEY=      # required for the tip_seek Places fallback + venue cards

# Rapport "By the way…" tile cadence. Doc default is MIN_HOURS=6, MAX_PER_7D=3.
# Both 0 = always surface a question whenever a gap is open. Deploy defaults these to 0.
LANA_RAPPORT_MIN_HOURS=0
LANA_RAPPORT_MAX_PER_7D=0

# Rapport tile rotation. refresh = a new question (round-robin by priority, no skip
# penalty) on every reload, debounced by ROTATE_GUARD_S; daily = same question re-shown
# until answered, rotating (as a soft skip) after ROTATE_HOURS unanswered.
LANA_RAPPORT_ROTATE_MODE=refresh
# LANA_RAPPORT_ROTATE_GUARD_S=30
# LANA_RAPPORT_ROTATE_HOURS=24

# CORS_ALLOW_ORIGINS=http://localhost:3000,https://app.tagalng.com
