# Copy to deploy/identity-worker.env (gitignored). Used by scripts/deploy-identity-worker.sh

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GCP_VERTEX_PROJECT=silver-bridge-381702
GCP_VERTEX_LOCATION=us-central1

# gemini-2.0-flash-001 retired 2026-06-01 — use gemini-2.5-flash
VERTEX_EXTRACT_MODEL=gemini-2.5-flash
VERTEX_EMBED_MODEL=text-embedding-005

# Optional: comma-separated origins for browser clients (default * in Cloud Run deploy)
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://your-preview.vercel.app
